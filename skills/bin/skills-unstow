#!/usr/bin/env bash
# skills-unstow — reverse of skills-stow; removes managed symlinks
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

require_stow

unstow_pkg() {
  local pkg="$1" src="$2" target="$3"; shift 3
  local extra=("$@")
  log "  unstow $pkg  ←  $target"
  stow -D "${extra[@]}" -d "$src" -t "$target" "$pkg" 2>/dev/null || true
}

while IFS= read -r src; do
  validate_source "$src" || continue
  log "Processing source: $src"

  if [[ -d "$src/shared" ]]; then
    unstow_pkg shared "$src" "$COPILOT_TARGET"
    unstow_pkg shared "$src" "$CLAUDE_TARGET" \
      --ignore='INDEX\.md' --ignore='README\.md'
  fi

  if [[ -d "$src/copilot" ]]; then
    unstow_pkg copilot "$src" "$COPILOT_TARGET"
  fi

  if [[ -d "$src/claude" ]]; then
    unstow_pkg claude "$src" "$CLAUDE_TARGET"
  fi
done < <(read_sources)

log "Done. (Backup files like INDEX.md.claude-managed.bak are untouched.)"
