#!/usr/bin/env bash
# skills-check — cross-source + cross-target conflict scanner (no side effects)
# Exits 0 if clean, non-zero on any conflict.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

conflicts=0

# Collect all skills per tool-target from all sources, detect cross-source dupes.
# skill_seen[target:name] = "source_path"
declare -A skill_seen

check_cross_source_dupes() {
  local src="$1"
  # shared → all targets
  for target_key in copilot claude gemini pi; do
    local skills_dir="$src/shared/skills"
    [[ -d "$skills_dir" ]] || continue
    for skill_path in "$skills_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      local key="$target_key:$name"
      if [[ -n "${skill_seen[$key]+_}" ]]; then
        err "Cross-source duplicate [$target_key]: skill '$name' in both '${skill_seen[$key]}' and '$src'"
        conflicts=$((conflicts + 1))
      else
        skill_seen[$key]="$src"
      fi
    done
  done

  # copilot-specific
  local copilot_dir="$src/copilot/skills"
  if [[ -d "$copilot_dir" ]]; then
    for skill_path in "$copilot_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      local key="copilot:$name"
      if [[ -n "${skill_seen[$key]+_}" ]]; then
        err "Cross-source duplicate [copilot]: skill '$name' in both '${skill_seen[$key]}' and '$src'"
        conflicts=$((conflicts + 1))
      else
        skill_seen[$key]="$src"
      fi
    done
  fi

  # claude-specific
  local claude_dir="$src/claude/skills"
  if [[ -d "$claude_dir" ]]; then
    for skill_path in "$claude_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      local key="claude:$name"
      if [[ -n "${skill_seen[$key]+_}" ]]; then
        err "Cross-source duplicate [claude]: skill '$name' in both '${skill_seen[$key]}' and '$src'"
        conflicts=$((conflicts + 1))
      else
        skill_seen[$key]="$src"
      fi
    done
  fi

  # gemini-specific
  local gemini_dir="$src/gemini/skills"
  if [[ -d "$gemini_dir" ]]; then
    for skill_path in "$gemini_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      local key="gemini:$name"
      if [[ -n "${skill_seen[$key]+_}" ]]; then
        err "Cross-source duplicate [gemini]: skill '$name' in both '${skill_seen[$key]}' and '$src'"
        conflicts=$((conflicts + 1))
      else
        skill_seen[$key]="$src"
      fi
    done
  fi

  # pi-specific
  local pi_dir="$src/pi/skills"
  if [[ -d "$pi_dir" ]]; then
    for skill_path in "$pi_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      local key="pi:$name"
      if [[ -n "${skill_seen[$key]+_}" ]]; then
        err "Cross-source duplicate [pi]: skill '$name' in both '${skill_seen[$key]}' and '$src'"
        conflicts=$((conflicts + 1))
      else
        skill_seen[$key]="$src"
      fi
    done
  fi
}

# Returns 0 if $1 is a stow-managed skill dir (SKILL.md is a symlink), 1 otherwise.
is_stow_managed() {
  local skill_dir="$1"
  [[ -L "$skill_dir/SKILL.md" ]]
}

check_target_collisions() {
  local src="$1"
  local skills_dir target existing

  # shared → all targets
  skills_dir="$src/shared/skills"
  if [[ -d "$skills_dir" ]]; then
    for skill_path in "$skills_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      for target in "$COPILOT_TARGET/skills" "$CLAUDE_TARGET/skills" "$GEMINI_TARGET/skills" "$PI_TARGET/skills"; do
        existing="$target/$name"
        if [[ -e "$existing" && ! -L "$existing" ]] && ! is_stow_managed "$existing"; then
          err "Target collision: '$existing' is a real directory (not stow-managed); would block stow of '$name' from '$src'"
          conflicts=$((conflicts + 1))
        fi
      done
    done
  fi

  # copilot-specific
  skills_dir="$src/copilot/skills"
  if [[ -d "$skills_dir" ]]; then
    for skill_path in "$skills_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      existing="$COPILOT_TARGET/skills/$name"
      if [[ -e "$existing" && ! -L "$existing" ]] && ! is_stow_managed "$existing"; then
        err "Target collision [copilot]: '$existing' is a real directory (not stow-managed); would block stow of '$name' from '$src'"
        conflicts=$((conflicts + 1))
      fi
    done
  fi

  # claude-specific
  skills_dir="$src/claude/skills"
  if [[ -d "$skills_dir" ]]; then
    for skill_path in "$skills_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      existing="$CLAUDE_TARGET/skills/$name"
      if [[ -e "$existing" && ! -L "$existing" ]] && ! is_stow_managed "$existing"; then
        err "Target collision [claude]: '$existing' is a real directory (not stow-managed); would block stow of '$name' from '$src'"
        conflicts=$((conflicts + 1))
      fi
    done
  fi

  # gemini-specific
  skills_dir="$src/gemini/skills"
  if [[ -d "$skills_dir" ]]; then
    for skill_path in "$skills_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      existing="$GEMINI_TARGET/skills/$name"
      if [[ -e "$existing" && ! -L "$existing" ]] && ! is_stow_managed "$existing"; then
        err "Target collision [gemini]: '$existing' is a real directory (not stow-managed); would block stow of '$name' from '$src'"
        conflicts=$((conflicts + 1))
      fi
    done
  fi

  # pi-specific
  skills_dir="$src/pi/skills"
  if [[ -d "$skills_dir" ]]; then
    for skill_path in "$skills_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local name; name="$(basename "$skill_path")"
      existing="$PI_TARGET/skills/$name"
      if [[ -e "$existing" && ! -L "$existing" ]] && ! is_stow_managed "$existing"; then
        err "Target collision [pi]: '$existing' is a real directory (not stow-managed); would block stow of '$name' from '$src'"
        conflicts=$((conflicts + 1))
      fi
    done
  fi
}

# Run checks across all sources
while IFS= read -r src; do
  validate_source "$src" || continue
  check_cross_source_dupes "$src"
  check_target_collisions "$src"
done < <(read_sources)

if [[ "$conflicts" -eq 0 ]]; then
  log "skills-check: OK — no conflicts."
  exit 0
else
  echo "" >&2
  err "$conflicts conflict(s) found. Resolve by:"
  err "  - renaming conflicting skill in one source, or"
  err "  - moving the real target dir aside (e.g. mv <dir> <dir>.bak), or"
  err "  - using skills-adopt to absorb tool-managed skills into a source"
  err "  Note: real dirs with a symlinked SKILL.md are stow-managed and are OK."
  exit 1
fi
