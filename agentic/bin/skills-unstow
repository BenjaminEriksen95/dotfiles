#!/usr/bin/env bash
# skills-unstow — reverse of skills-stow; removes managed symlinks
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

require_stow

unstow_pkg() {
  local pkg="$1" src="$2" target="$3"; shift 3
  local extra=("$@")
  log "  unstow $pkg  ←  $target"
  stow -D --no-folding "${extra[@]}" -d "$src" -t "$target" "$pkg" 2>/dev/null || true
}

while IFS= read -r src; do
  validate_source "$src" || continue
  log "Processing source: $src"

  if [[ -d "$src/shared" ]]; then
    unstow_pkg shared "$src" "$COPILOT_TARGET"
    unstow_pkg shared "$src" "$CLAUDE_TARGET" \
      --ignore='INDEX\.md' --ignore='README\.md'
    unstow_pkg shared "$src" "$GEMINI_TARGET" \
      --ignore='INDEX\.md' --ignore='README\.md'
    unstow_pkg shared "$src" "$PI_TARGET" \
      --ignore='INDEX\.md' --ignore='README\.md'
  fi

  if [[ -d "$src/copilot" ]]; then
    unstow_pkg copilot "$src" "$COPILOT_TARGET"
  fi

  if [[ -d "$src/claude" ]]; then
    unstow_pkg claude "$src" "$CLAUDE_TARGET"
  fi

  if [[ -d "$src/gemini" ]]; then
    unstow_pkg gemini "$src" "$GEMINI_TARGET"
  fi

  if [[ -d "$src/pi" ]]; then
    unstow_pkg pi "$src" "$PI_TARGET"
  fi
done < <(read_sources)

# ---------------------------------------------------------------------------
# Post-unstow cleanup: stow -D removes symlinks but leaves empty directory
# scaffolding behind (a known stow --no-folding behaviour). Remove any skill
# dir across all targets that no longer contains a SKILL.md (real or symlink),
# since that means stow hollowed it out. Real tool-installed skills always
# have a real SKILL.md, so they are safe from this sweep.
# ---------------------------------------------------------------------------
log "Cleaning up stow scaffolding (empty skill dirs left by stow -D)..."
all_targets=("$COPILOT_TARGET" "$CLAUDE_TARGET" "$GEMINI_TARGET" "$PI_TARGET")
while IFS= read -r src; do
  validate_source "$src" 2>/dev/null || continue
  for pkg_dir in "$src/shared/skills" "$src/copilot/skills" "$src/claude/skills" \
                  "$src/gemini/skills" "$src/pi/skills"; do
    [[ -d "$pkg_dir" ]] || continue
    for skill_path in "$pkg_dir"/*/; do
      [[ -d "$skill_path" ]] || continue
      local_name="$(basename "$skill_path")"
      for tgt in "${all_targets[@]}"; do
        candidate="$tgt/skills/$local_name"
        if [[ -d "$candidate" && ! -e "$candidate/SKILL.md" ]]; then
          log "  removing stow scaffold: $candidate"
          rm -rf "$candidate"
        fi
      done
    done
  done
done < <(read_sources)

log "Done. (Backup files like INDEX.md.claude-managed.bak are untouched.)"
